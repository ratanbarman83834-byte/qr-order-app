# Copy this file to .env and fill in values from your Firebase project
# (Project settings → General → Your apps → SDK setup and configuration).
# These are all client-side identifiers, not secrets — real access control
# is enforced by firestore.rules and storage.rules, not by hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Project settings → Cloud Messaging → Web configuration → Web Push
# certificates ("Generate key pair" if you don't have one yet).
VITE_FIREBASE_VAPID_KEY=

# Used only by scripts/seedDemoData.mjs (a one-off Node script, not shipped
# to the browser) to authenticate as an admin when seeding demo data.
# Project settings → Service accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
